{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "3to1go",
  "description": "Self-hosted, encrypted backups: Scout backs up your machines, Station stores the snapshots.",
  "colors": {
    "primary": "#c73346",
    "light": "#e05263",
    "dark": "#c73346"
  },
  "logo": {
    "light": "/images/3to1go.png",
    "dark": "/images/3to1go.png"
  },
  "favicon": "/images/favicon.png",
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://buymeacoffee.com/thesteau"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/thesteau/3to1go"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "icon": "house",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "Concepts",
            "pages": ["concepts/how-it-works", "concepts/storage-and-3-2-1", "concepts/design-decisions"]
          },
          {
            "group": "Both apps",
            "pages": ["shared/sign-in", "shared/trusted-certificates"]
          },
          {
            "group": "Contributing",
            "pages": ["development", "releases"]
          }
        ]
      },
      {
        "tab": "Station",
        "icon": "server",
        "groups": [
          {
            "group": "Station",
            "pages": ["station/overview", "station/install", "station/configuration"]
          },
          {
            "group": "Using Station",
            "pages": [
              "station/scout-credentials",
              "station/snapshots",
              "station/notifications",
              "station/hooks",
              "station/reset-admin-password",
              "station/disaster-recovery"
            ]
          }
        ]
      },
      {
        "tab": "Scout",
        "icon": "laptop",
        "groups": [
          {
            "group": "Scout",
            "pages": ["scout/overview", "scout/install", "scout/kubernetes", "scout/configuration"]
          },
          {
            "group": "Using Scout",
            "pages": [
              "scout/backup-jobs",
              "scout/unusual-backups",
              "scout/multiple-folders",
              "scout/restore",
              "scout/encryption-key",
              "scout/notifications",
              "scout/hooks"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/central/configuration", "destination": "/station/configuration" },
    { "source": "/central/disaster-recovery", "destination": "/station/disaster-recovery" },
    { "source": "/central/edge-credentials", "destination": "/station/scout-credentials" },
    { "source": "/central/hooks", "destination": "/station/hooks" },
    { "source": "/central/install", "destination": "/station/install" },
    { "source": "/central/notifications", "destination": "/station/notifications" },
    { "source": "/central/overview", "destination": "/station/overview" },
    { "source": "/central/reset-admin-password", "destination": "/station/reset-admin-password" },
    { "source": "/central/snapshots", "destination": "/station/snapshots" },
    { "source": "/edge/backup-jobs", "destination": "/scout/backup-jobs" },
    { "source": "/edge/configuration", "destination": "/scout/configuration" },
    { "source": "/edge/encryption-key", "destination": "/scout/encryption-key" },
    { "source": "/edge/hooks", "destination": "/scout/hooks" },
    { "source": "/edge/install", "destination": "/scout/install" },
    { "source": "/edge/kubernetes", "destination": "/scout/kubernetes" },
    { "source": "/edge/multiple-folders", "destination": "/scout/multiple-folders" },
    { "source": "/edge/notifications", "destination": "/scout/notifications" },
    { "source": "/edge/overview", "destination": "/scout/overview" },
    { "source": "/edge/restore", "destination": "/scout/restore" },
    { "source": "/edge/unusual-backups", "destination": "/scout/unusual-backups" }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/thesteau/3to1go"
    }
  }
}
