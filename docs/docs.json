{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "3to1go",
  "description": "Self-hosted, encrypted backups: Scout backs up your machines, Station stores the snapshots.",
  "colors": {
    "primary": "#c73346",
    "light": "#e05263",
    "dark": "#c73346"
  },
  "logo": {
    "light": "/images/3to1go.png",
    "dark": "/images/3to1go.png"
  },
  "favicon": "/images/favicon.png",
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://buymeacoffee.com/thesteau"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/thesteau/3to1go"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "icon": "house",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "Concepts",
            "pages": ["concepts/how-it-works", "concepts/storage-and-3-2-1", "concepts/design-decisions"]
          },
          {
            "group": "Both apps",
            "pages": ["shared/sign-in", "shared/trusted-certificates"]
          },
          {
            "group": "Contributing",
            "pages": ["development", "releases"]
          }
        ]
      },
      {
        "tab": "Station",
        "icon": "server",
        "groups": [
          {
            "group": "Station",
            "pages": ["station/overview", "station/install", "station/configuration"]
          },
          {
            "group": "Using Station",
            "pages": [
              "station/station-tokens",
              "station/snapshots",
              "station/notifications",
              "station/hooks",
              "station/reset-admin-password",
              "station/disaster-recovery"
            ]
          }
        ]
      },
      {
        "tab": "Scout",
        "icon": "laptop",
        "groups": [
          {
            "group": "Scout",
            "pages": ["scout/overview", "scout/install", "scout/kubernetes", "scout/configuration"]
          },
          {
            "group": "Using Scout",
            "pages": [
              "scout/backup-jobs",
              "scout/unusual-backups",
              "scout/multiple-folders",
              "scout/restore",
              "scout/scout-key",
              "scout/notifications",
              "scout/hooks"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/scout/encryption-key",
      "destination": "/scout/scout-key"
    },
    {
      "source": "/station/scout-credentials",
      "destination": "/station/station-tokens"
    }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/thesteau/3to1go"
    }
  }
}
