# Edit these first for your environment.
# SCOUT_ID should be unique per Scout installation.
# STATION_URL must be reachable from the Scout container.
# If you also use deploy-example/station on the same Docker Desktop host,
# this is usually http://host.docker.internal:6555.
SCOUT_ID=scout-01
STATION_URL=http://host.docker.internal:6555
# Used only when Scout creates the first admin user in an empty database.
# If unset, the initial password falls to admin.
INITIAL_ADMIN_PASSWORD=admin
# ONE FOLDER: SCAN_DIR is the folder on your computer mounted at /scan inside Scout.
SCAN_DIR=./scan

# MULTIPLE FOLDERS / DRIVES: configure these in docker-compose.yml, not as a list here.
# Replace the "${SCAN_DIR:-./scan}:/scan" volume entry with one entry per folder:
#   - "C:/Users/Alice:/scan/main"
#   - "D:/Projects:/scan/projects"
# Use your own existing paths. The left side is on your computer; the right is in Scout.
# Remove SCAN_DIR from your .env after switching to those explicit entries.
# Keep SCAN_ROOT=/scan if explicitly set (it is already the container default).
# Run: docker compose up -d --force-recreate scout
# Then refresh Scout's UI and select folders beneath main/projects for backup.
# These comments do not create mounts; edit docker-compose.yml to activate them.
# See https://3to1go.docs.thesteau.com/scout/multiple-folders
