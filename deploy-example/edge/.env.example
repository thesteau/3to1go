# Edit these first for your environment.
# EDGE_ID should be unique per Edge installation.
# CENTRAL_URL must be reachable from the Edge container.
# If you also use deploy-example/central on the same Docker Desktop host,
# this is usually http://host.docker.internal:6555.
EDGE_ID=edge-01
CENTRAL_URL=http://host.docker.internal:6555
# Used only when Edge creates the first admin user in an empty database.
# If unset, the initial password falls to admin.
INITIAL_ADMIN_PASSWORD=admin
# ONE FOLDER: SCAN_DIR is the folder on your computer mounted at /scan inside Edge.
SCAN_DIR=./scan

# MULTIPLE FOLDERS / DRIVES: configure these in docker-compose.yml, not as a list here.
# Replace the "${SCAN_DIR:-./scan}:/scan" volume entry with one entry per folder:
#   - "C:/Users/Alice:/scan/main"
#   - "D:/Projects:/scan/projects"
# Use your own existing paths. The left side is on your computer; the right is in Edge.
# Remove SCAN_DIR from your .env after switching to those explicit entries.
# Keep SCAN_ROOT=/scan if explicitly set (it is already the container default).
# Run: docker compose up -d --force-recreate edge
# Then refresh Edge's UI and select folders beneath main/projects for backup.
# These comments do not create mounts; edit docker-compose.yml to activate them.
# See the root README: "Multiple Folders Or Drives With Docker".
