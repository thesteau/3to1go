# Images compile the web UI in their own Node stage; never copy local build output.
node_modules/
station/static/js/
scout/static/js/

# Only source assets belong in the build context.
.git/
tests/
reports/
**/*_test.go
**/testdata/
**/.env
**/.env.*
!**/.env.example
station/config/
station/data/
station/hook-scripts/
station/secrets/
scout/config/
scout/data/
scout/hook-scripts/
scout/secrets/
scout/scan/
scout/state/
scout/spool/
data/
certs/
coverage.out
*.coverprofile
*.prof
*.test
*.log
