{
  "name": "3to1go-web",
  "private": true,
  "description": "TypeScript sources for the Station and Scout web UIs. Compiled to */static/js (not committed), which the Go servers embed.",
  "scripts": {
    "build": "tsc -p station/static && tsc -p scout/static",
    "watch": "tsc -p station/static --watch --preserveWatchOutput",
    "watch:scout": "tsc -p scout/static --watch --preserveWatchOutput",
    "lint": "cd .. && node app/node_modules/@biomejs/biome/bin/biome ci .",
    "fix": "cd .. && node app/node_modules/@biomejs/biome/bin/biome check --write .",
    "test": "npm run build && cd .. && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/test-report.cts --test-reporter-destination=stdout \"tests/**/*.test.cts\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "release-please": "17.11.2",
    "typescript": "7.0.2"
  }
}
