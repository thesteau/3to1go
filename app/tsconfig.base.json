{
  // Each UI compiles shared/ts and its own sources to classic scripts in js/, which Go embeds.
  // Files share one global scope, so they must not use import/export.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "removeComments": false,
    "newLine": "lf",
    "skipLibCheck": true,
    "types": []
  }
}
